# =============================================================================
# Convex
# =============================================================================
# Don't fill these by hand — `npx convex dev` writes the real values into
# .env.local for you (CONVEX_DEPLOYMENT is the CLI's deployment pointer,
# NEXT_PUBLIC_CONVEX_URL is your deployment URL).
CONVEX_DEPLOYMENT=your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# =============================================================================
# Auth (better-auth) — REQUIRED FOR LOGIN
# =============================================================================
# DUAL-RUNTIME: these are read by BOTH the Next.js server (.env.local) and the
# Convex deployment. After `cp`, also set them on Convex:
#   npx convex env set BETTER_AUTH_SECRET <value>
#   npx convex env set GITHUB_CLIENT_ID <value>
#   npx convex env set GITHUB_CLIENT_SECRET <value>
# Without them the dashboard is unreachable (login is required) and GitHub
# OAuth fails.

# BETTER_AUTH_SECRET: Generate a random string (min 32 chars) for session
# encryption. Run: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# GITHUB_CLIENT_ID: From GitHub OAuth App settings
# Create an OAuth App at https://github.com/settings/developers
# Set Authorization callback URL to: https://your-domain.com/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id

# GITHUB_CLIENT_SECRET: From GitHub OAuth App settings
# Create an OAuth App at https://github.com/settings/developers
# Keep this secret and never commit it to git
GITHUB_CLIENT_SECRET=your-github-client-secret

# OPTIONAL BETTER_AUTH_URL: absolute app URL used by better-auth on both
# runtimes. Defaults to NEXT_PUBLIC_APP_URL (below) — only set it if you need
# auth to point somewhere else.

# =============================================================================
# AI - Optional (the run loop works in mock mode without any AI key)
# =============================================================================
# DUAL-RUNTIME: AI calls run in the CONVEX runtime (the Sigma agent + run
# processing), so set your chosen key(s) on the deployment too:
#   npx convex env set VERCEL_AI_GATEWAY_API_KEY <value>
# (.env.local copies are only used by hypothetical Next.js-side AI code.)

# Preferred: Vercel AI Gateway — one key gives you every provider/model
# (OpenAI, Anthropic, Google, ...) at provider list prices with zero markup.
# Create a key at https://vercel.com/dashboard/ai-gateway/keys
# REQUIRED ON THE CONVEX DEPLOYMENT — the Vercel OIDC fallback does not exist
# in the Convex runtime. (OIDC only applies if you add Next.js-side AI calls.)
VERCEL_AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# Fallbacks: direct provider keys (used only if no gateway key is set; also
# set on the Convex deployment via `npx convex env set`)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# OPTIONAL: override the default model (gateway ids are "provider/model",
# e.g. openai/gpt-5-mini or anthropic/claude-sonnet-4-5)
# AI_MODEL=openai/gpt-5-mini

# =============================================================================
# Analytics (PostHog) - Optional
# =============================================================================
# Next.js-side only (.env.local is enough — nothing here is read by Convex).
# Product analytics + error tracking + AI observability in one SDK.
# No key = no tracking, everything else works.
# Session replay and feature flags need no code — enable them from the
# PostHog dashboard settings when wanted.
# Get from https://us.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# Polar Billing - Optional (app runs in free mode without these)
# =============================================================================
# Fixed Free/Pro tiers via @convex-dev/polar (Polar is merchant of record).
# These are read by the CONVEX runtime, so set them with `npx convex env set`
# (not just in .env.local). Missing keys = no paywall, free quotas enforced.

# POLAR_ORGANIZATION_TOKEN: Organization token from Polar settings.
# Required scopes: products:read, products:write, subscriptions:read,
# subscriptions:write, customers:read, customers:write, checkouts:read,
# checkouts:write, customer_sessions:write, customer_portal:write
# Create at https://polar.sh/settings/tokens
POLAR_ORGANIZATION_TOKEN=your-polar-organization-token

# POLAR_PRO_PRODUCT_ID: The Pro product ID from your Polar dashboard.
# Create a recurring monthly product, then copy its ID.
POLAR_PRO_PRODUCT_ID=prod_your-pro-product-id

# POLAR_WEBHOOK_SECRET: Signing secret for the Polar webhook that points at
# https://<your-deployment>.convex.site/polar/events (subscribe to
# subscription.created/updated and product.created/updated events).
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# POLAR_SERVER: "sandbox" (default) or "production"
# POLAR_SERVER=sandbox

# =============================================================================
# Resend Email - Optional (emails are skipped without a key)
# =============================================================================
# DUAL-RUNTIME: email is sent from the CONVEX runtime — set the key there:
#   npx convex env set RESEND_API_KEY <value>
# Get from https://resend.com/api-keys
# Used for sending emails (OTP codes, welcome, subscription confirmations).
# Without RESEND_API_KEY every send is skipped silently (debug logged).
# NOTE: with a key set, emails are delivered for real. Set RESEND_TEST_MODE
# to "true" to restrict delivery to resend.dev test addresses while testing.
RESEND_API_KEY=re_your-resend-api-key

# RESEND_TEST_MODE: "true" = Resend component test mode (resend.dev only).
# Unset or anything else = real sends (Convex runtime reads this; set it with
# `npx convex env add RESEND_TEST_MODE` for deployments).
# RESEND_TEST_MODE=true

# RESEND_FROM: optional "From" header. Default: "ChadNext <onboarding@resend.dev>"
# Use a verified domain, e.g. "ChadNext <hello@yourdomain.com>"
# RESEND_FROM=ChadNext <onboarding@resend.dev>

# =============================================================================
# App Configuration
# =============================================================================
# Your app's public URL (no trailing slash)
# Used for OAuth callbacks, webhooks, and email links
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
