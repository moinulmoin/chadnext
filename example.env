# =============================================================================
# Convex
# =============================================================================
# Get these from your Convex dashboard at https://dashboard.convex.dev
# CONVEX_DEPLOYMENT is the deployment name shown in the dashboard
# NEXT_PUBLIC_CONVEX_URL is your Convex deployment URL (starts with https://)
CONVEX_DEPLOYMENT=your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# =============================================================================
# Auth (better-auth)
# =============================================================================
# BETTER_AUTH_SECRET: Generate a random string for session encryption
# Run: openssl rand -base64 32
# Required for session security
BETTER_AUTH_SECRET=your-random-secret-string

# GITHUB_CLIENT_ID: From GitHub OAuth App settings
# Create an OAuth App at https://github.com/settings/developers
# Set Authorization callback URL to: https://your-domain.com/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id

# GITHUB_CLIENT_SECRET: From GitHub OAuth App settings
# Create an OAuth App at https://github.com/settings/developers
# Keep this secret and never commit it to git
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# AI (OpenAI) - Optional
# =============================================================================
# OPENAI_API_KEY: Get from https://platform.openai.com/api-keys
# OPTIONAL: App works without this. AI copilot will show setup prompt if missing.
OPENAI_API_KEY=sk-your-openai-api-key  # Optional - app works without this

# =============================================================================
# Polar Billing
# =============================================================================
# Get these from your Polar dashboard at https://polar.sh/dashboard
# Create products first, then configure these values

# POLAR_ACCESS_TOKEN: Personal access token for API access
# Create at https://polar.sh/settings/tokens
POLAR_ACCESS_TOKEN=your-polar-access-token

# POLAR_WEBHOOK_SECRET: Secret to verify Polar webhook signatures
# Create a webhook in Polar and copy the signing secret
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# POLAR_FREE_PRODUCT_ID: Your Free tier product ID from Polar
# Create a product in Polar and copy the product ID
POLAR_FREE_PRODUCT_ID=prod_your-free-product-id

# POLAR_PRO_PRODUCT_ID: Your Pro tier product ID from Polar
# Create a product in Polar and copy the product ID
POLAR_PRO_PRODUCT_ID=prod_your-pro-product-id

# =============================================================================
# Resend Email
# =============================================================================
# Get from https://resend.com/api-keys
# Used for sending emails (welcome, OTP, billing notifications)
RESEND_API_KEY=re_your-resend-api-key

# =============================================================================
# App Configuration
# =============================================================================
# Your app's public URL (no trailing slash)
# Used for OAuth callbacks, webhooks, and email links
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
